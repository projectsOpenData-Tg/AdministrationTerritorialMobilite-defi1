# Secrets de l'application — modèle. Ne jamais commiter le fichier réel.
#
# En local  : copier ce fichier en « secrets.toml » dans le même dossier (il est ignoré par git).
# En ligne  : Streamlit Community Cloud → l'application → Settings → Secrets, coller ces deux lignes.
#
# Les deux valeurs absentes, l'alerte de visite (dashboard/notify.py) ne fait rien du tout.
# Le jeton est celui du fichier .env du dépôt ; l'identifiant de conversation s'obtient en écrivant
# un message au bot, puis en lisant https://api.telegram.org/bot<JETON>/getUpdates (champ chat.id).

TELEGRAM_BOT_TOKEN = "000000000:remplacer-par-le-jeton-de-BotFather"
TELEGRAM_CHAT_ID = "000000000"
